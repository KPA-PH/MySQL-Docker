TZ=Asia/Manila

MYSQL84_ROOT_PASSWORD=ABC12abc
MYSQL84_BIND_ADDRESS=127.0.0.1
MYSQL84_PORT=3306

POSTGRES18_DB=app
POSTGRES18_USER=app
POSTGRES18_PASSWORD=ABC12abc
POSTGRES18_BIND_ADDRESS=127.0.0.1
POSTGRES18_PORT=5432
# Sized for a shared 4-core / 16GB Proxmox VM: ~6GB / 2 cores for Postgres,
# leaving ~10GB / 2 cores for the OS and other projects on the same VM.
POSTGRES18_MAX_CONNECTIONS=100
POSTGRES18_SHARED_BUFFERS=1536MB
POSTGRES18_EFFECTIVE_CACHE_SIZE=4GB
POSTGRES18_WORK_MEM=16MB
POSTGRES18_MAINTENANCE_WORK_MEM=256MB
POSTGRES18_MAX_WORKER_PROCESSES=4
POSTGRES18_MAX_PARALLEL_WORKERS=2
POSTGRES18_MAX_PARALLEL_WORKERS_PER_GATHER=2
POSTGRES18_WAL_BUFFERS=16MB
POSTGRES18_MIN_WAL_SIZE=1GB
POSTGRES18_MAX_WAL_SIZE=4GB
POSTGRES18_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES18_LOG_MIN_DURATION_STATEMENT=1000
POSTGRES18_SHM_SIZE=512mb
POSTGRES18_CPU_LIMIT=2
POSTGRES18_MEMORY_LIMIT=6g
POSTGRES18_MEMORY_RESERVATION=1g

# PgBouncer — connection pooler in front of Postgres. Point your app at port 6432.
# Pool math: DEFAULT_POOL_SIZE x (user/db pairs) must stay under MAX_DB_CONNECTIONS,
# which is kept below POSTGRES18_MAX_CONNECTIONS (100) to leave room for admin/superuser.
PGBOUNCER_BIND_ADDRESS=127.0.0.1
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=25
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_TIMEOUT=3
PGBOUNCER_MAX_DB_CONNECTIONS=90
PGBOUNCER_SERVER_IDLE_TIMEOUT=600
PGBOUNCER_CPU_LIMIT=1
PGBOUNCER_MEMORY_LIMIT=256m
PGBOUNCER_MEMORY_RESERVATION=64m

VALKEY_PASSWORD=ABC12abc
VALKEY_BIND_ADDRESS=127.0.0.1
VALKEY_PORT=6379
